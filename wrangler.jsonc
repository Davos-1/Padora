{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padora",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padora-shop",
      "database_id": "353cdc54-4139-42e9-93fc-9f5f6f46788e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://padora.ch"
  }
  // Secrets (never commit): PAYREXX_INSTANCE, PAYREXX_API_KEY, RESEND_API_KEY
  // -> local: .dev.vars ; production: `wrangler secret put <NAME>`
}
