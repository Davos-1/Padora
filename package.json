{
  "name": "padora-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Padora – Onlineshop für Padel-Zubehör (padora.ch)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:products": "tsx scripts/validate-products.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm validate:products",
    "cf:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply padora-shop --local",
    "db:migrate:remote": "wrangler d1 migrations apply padora-shop --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.5",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@10.33.0"
}
